/* imedemo.rcss -- IME verification page.
 *
 * Two hard rules, both from the VaCuus IME postmortem:
 *   1. CJK needs a registered fallback face. LatoLatin has no CJK glyphs and
 *      a missing glyph renders as a tofu box, which is a FONT problem, not an
 *      IME problem. Do not debug the IME for it.
 *   2. The input's height / padding / line-height must be defined together and
 *      with box-sizing:border-box. RmlUi lays text out from the top of the
 *      content box, so a field taller than its line-height pushes the text (and
 *      the caret) up off the baseline.
 */

/* CJK face. src is ROOT-relative to Content/DevUI and takes no url(). */
@font-face {
	src: fonts/SimHei.ttf;
	font-family: "CJK";
	-rmlui-fallback-face: true;
}

/* No user-agent sheet: blockify the common elements first. */
body, div, p, h1, label, ul, li, form { display: block; }
span, a, b, i, em, strong, code { display: inline; }

body {
	width: 100%;
	height: 100%;
	font-family: LatoLatin;
	font-size: 15px;
	color: #e6edf7;
	background: #080b14;
}

#backdrop-glow {
	position: absolute;
	left: 18%;
	top: 6%;
	width: 420px;
	height: 420px;
	border-radius: 210px;
	background: #1b3a6b;
	opacity: 0.35;
}

#panel {
	position: relative;
	width: 560px;
	margin: 40px auto;
	padding: 28px 30px 30px 30px;
	background: #0e1522;
	border-radius: 14px;
	border: 1px solid #1e2b42;
}

#header { margin-bottom: 22px; }
#title-row { margin-bottom: 6px; }

#badge {
	display: inline-block;
	padding: 3px 9px;
	margin-right: 10px;
	background: #1f6feb;
	border-radius: 6px;
	color: #ffffff;
	font-size: 12px;
	vertical-align: middle;
}

h1 {
	display: inline;
	font-size: 24px;
	color: #f2f7ff;
	vertical-align: middle;
}

.subtitle {
	font-size: 13px;
	color: #6e82a3;
	margin: 0 0 0 2px;
}

.card {
	padding: 16px 18px;
	margin-bottom: 14px;
	background: #121b2c;
	border-radius: 10px;
	border: 1px solid #1c2942;
}

.field-label {
	font-size: 12px;
	color: #7f93b5;
	margin-bottom: 9px;
	letter-spacing: 0.4px;
}

/* height 46 = 24 line + 11 top + 11 bottom. All three fixed together. */
.text-input {
	box-sizing: border-box;
	width: 100%;
	height: 46px;
	padding: 11px 14px;
	background: #070c16;
	border: 1px solid #253550;
	border-radius: 8px;
	color: #e6edf7;
	font-family: LatoLatin;
	font-size: 16px;
	line-height: 24px;
}

.text-input:focus {
	border-color: #1f6feb;
	background: #08101d;
}

/* 2026-11-18 company fix (VaCuus-Multiline-Fix.html): the OUTER box owns
   height/border/scroll; the textarea inside only edits and grows (imedemo.js).
   RmlUi textareas get a constructor inline overflow-y:auto -- only an INLINE
   hidden from script beats it; that internal scroll path is what blanked the
   field on overflow. Height 96 = 24*3 lines + 12*2 padding (unchanged). */
#multi-scroll {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 96px;
	padding: 12px 14px;
	background: #070c16;
	border: 1px solid #253550;
	border-radius: 8px;
	overflow-y: auto;
}

#multi-scroll.focused { border-color: #1f6feb; }

/* RmlUi has no default scrollbar style: without an explicit width the bar is
   zero-width and invisible (fix note, key detail #4). */
#multi-scroll scrollbarvertical { width: 8px; }
#multi-scroll scrollbarvertical slidertrack { background: #0a1526; border-radius: 4px; }
#multi-scroll scrollbarvertical slidertrack sliderbar { background: #2a4a73; border-radius: 4px; }

.text-area {
	display: block;
	box-sizing: border-box;
	width: 100%;
	/* Content-driven from imedemo.js (GROW); minimum = the scroller's content
	   area (96 - 2*12 padding) so the empty state fills the box. */
	height: 72px;
	padding: 0;
	background: transparent;
	border: 0;
	border-radius: 0;
	color: #e6edf7;
	font-size: 15px;
	line-height: 24px;
}

.hint {
	margin-top: 8px;
	font-size: 12px;
	color: #5d7091;
}

#result-row {
	display: block;
	padding: 7px 0;
	border-bottom: 1px solid #182338;
}

.kv {
	display: inline-block;
	width: 90px;
	font-size: 13px;
	color: #7f93b5;
}

.value {
	display: inline-block;
	font-size: 15px;
	color: #39d353;
}

.checklist ul {
	list-style-type: none;
	padding: 0;
	margin: 0;
}

.checklist li {
	padding: 5px 0 5px 20px;
	font-size: 13px;
	color: #93a4c1;
	border-bottom: 1px solid #131d2e;
}
