/* imedemo.rcss - IME 验证页样式 */

/* 没有 UA 样式表：先把块级元素立起来 */
body, div, p, h1, label, ul, li, form { display: block; }
span, a, b, i, em, strong, code { display: inline; }

body {
	width: 100%;
	height: 100%;
	font-family: LatoLatin;
	font-size: 15px;
	color: #e6edf7;
	background: #080b14;
}

/* 背景光晕 */
#backdrop-glow {
	position: absolute;
	left: 18%;
	top: 6%;
	width: 420px;
	height: 420px;
	border-radius: 210px;
	background: #1b3a6b;
	opacity: 0.35;
}

/* 主面板 */
#panel {
	position: relative;
	width: 560px;
	margin: 40px auto;
	padding: 28px 30px 30px 30px;
	background: #0e1522;
	border-radius: 14px;
	border: 1px solid #1e2b42;
}

/* 头部 */
#header { margin-bottom: 22px; }
#title-row { margin-bottom: 6px; }

#badge {
	display: inline-block;
	padding: 3px 9px;
	margin-right: 10px;
	background: #1f6feb;
	border-radius: 6px;
	color: #ffffff;
	font-size: 12px;
	vertical-align: middle;
}

h1 {
	display: inline;
	font-size: 24px;
	color: #f2f7ff;
	vertical-align: middle;
}

.subtitle {
	font-size: 13px;
	color: #6e82a3;
	margin: 0 0 0 2px;
}

/* 卡片 */
.card {
	padding: 16px 18px;
	margin-bottom: 14px;
	background: #121b2c;
	border-radius: 10px;
	border: 1px solid #1c2942;
}

.field-label {
	font-size: 12px;
	color: #7f93b5;
	margin-bottom: 9px;
	letter-spacing: 0.4px;
}

/* 输入框 */
.text-input {
	width: 100%;
	height: 46px;
	padding: 11px 14px;
	background: #070c16;
	border: 1px solid #253550;
	border-radius: 8px;
	color: #e6edf7;
	font-size: 16px;
	line-height: 24px;
}

.text-input:focus {
	border-color: #1f6feb;
	background: #08101d;
}

.text-area {
	width: 100%;
	height: 96px;
	padding: 11px 14px;
	background: #070c16;
	border: 1px solid #253550;
	border-radius: 8px;
	color: #e6edf7;
	font-size: 15px;
	line-height: 24px;
}

.text-area:focus { border-color: #1f6feb; }

.hint {
	margin-top: 8px;
	font-size: 12px;

	color: #5d7091;
}

/* 结果行 */
#result-row {
	display: block;
	padding: 7px 0;
	border-bottom: 1px solid #182338;
}

.kv {
	display: inline-block;
	width: 90px;
	font-size: 13px;
	color: #7f93b5;
}

.value {
	display: inline-block;
	font-size: 15px;
	color: #39d353;
}

/* 清单 */
.checklist ul {
	list-style-type: none;
	padding: 0;
	margin: 0;
}

.checklist li {
	padding: 5px 0 5px 20px;
	font-size: 13px;
	color: #93a4c1;
	border-bottom: 1px solid #131d2e;
}
